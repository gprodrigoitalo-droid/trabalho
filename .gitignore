Algoritmo 20

  fun main() {
      print("Digite palavra 1: ")
      val c = readLine()!!
      print("Digite palavra 2: ")
      val c1 = readLine()!!


          println("Tamanho: ${c.length}")
          println("Concatenando: ${c + c1}")
          println("Primeiro caractere: ${c.first()}")
          println("Último caractere: ${c.last()}")
